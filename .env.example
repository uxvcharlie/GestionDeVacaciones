# ===========================================================================
#  Variables de entorno del sistema de registro de vacaciones
#  ---------------------------------------------------------------------------
#  COPIÁ este archivo a ".env" y poné TUS valores reales:
#       cp .env.example .env
#
#  El archivo ".env" está en .gitignore: nunca se sube a GitHub.
#  Este archivo (.env.example) SÍ se sube, pero jamás con valores reales.
#
#  OJO: los valores con espacios van entre comillas, por ejemplo
#  ADMIN_NOMBRE="Brenda Vásquez". Sin comillas, el script de arranque
#  lee solo la primera palabra y la variable queda vacía.
# ===========================================================================

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Local (contenedor de Postgres en Podman, ver README):
DB_URL=jdbc:postgresql://localhost:5432/vacaciones
DB_USUARIO=vacaciones
DB_PASSWORD=cambiame_por_una_contrasena_larga

# ---------------------------------------------------------------------------
# Usuario administrador inicial
# ---------------------------------------------------------------------------
# Se crea UNA SOLA VEZ, en el primer arranque, y solo si la tabla de usuarios
# está vacía. La contraseña debe tener 12 caracteres o más: si es más corta o
# es una contraseña común, la aplicación NO arranca y te dice por qué.
# En el primer ingreso el sistema la obliga a cambiarla.
ADMIN_USERNAME=brenda
ADMIN_PASSWORD_INICIAL=cambiame_antes_de_arrancar
ADMIN_NOMBRE="Brenda Vásquez"

# ---------------------------------------------------------------------------
# Cookie de sesión
# ---------------------------------------------------------------------------
# false en tu computadora (http://localhost no es HTTPS y la cookie "Secure"
# no viajaría, así que no podrías entrar).
# true en producción (Render sirve por HTTPS).
COOKIE_SEGURA=false

# ---------------------------------------------------------------------------
# Puerto (Render lo define solo; en local podés dejarlo en 8080)
# ---------------------------------------------------------------------------
PORT=8080
