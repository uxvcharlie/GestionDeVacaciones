# ---------------------------------------------------------------------------
# Java / Maven
# ---------------------------------------------------------------------------
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
!app-android/gradle/wrapper/gradle-wrapper.jar
.mvn/timing.properties

# ---------------------------------------------------------------------------
# Secretos: NUNCA se suben al repositorio
# ---------------------------------------------------------------------------
.env
.env.local
.env.respaldo

# Respaldos de la base: tienen datos personales
*.dump
*.dump.parcial
*.pem
*.key

# Firma de la app Android: si alguien la tiene, puede publicar versiones
# falsas de la app que el celular aceptaría como actualizaciones legítimas.
*.jks
*.keystore
app-android/firma.properties

# Respaldos que exporta la app del celular: tienen datos de los funcionarios
respaldo-vacaciones-*.json

# ---------------------------------------------------------------------------
# App Android (Gradle)
# ---------------------------------------------------------------------------
app-android/.gradle/
app-android/.kotlin/
app-android/build/
app-android/app/build/
# Ruta del SDK en cada computadora: no es igual en todas.
app-android/local.properties

# ---------------------------------------------------------------------------
# Herramientas de interfaz (Tailwind se instala local, no se versiona)
# ---------------------------------------------------------------------------
node_modules/
# package-lock.json SÍ se versiona: fija las versiones exactas de Tailwind

# ---------------------------------------------------------------------------
# Editores e IDE
# ---------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
nbproject/

# ---------------------------------------------------------------------------
# Sistema operativo
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*~
