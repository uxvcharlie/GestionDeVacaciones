# ===========================================================================
#  Configuración de los respaldos. Copialo a .env.respaldo y completalo:
#      cp .env.respaldo.example .env.respaldo
#  .env.respaldo está en .gitignore: nunca se sube a GitHub.
# ===========================================================================

# La cadena de conexión de Neon, en formato postgresql:// (NO la jdbc:).
# En Neon: Dashboard → Connect → desmarcá "Connection pooling" → copiá la URL.
URL_BASE_PRODUCCION=postgresql://usuario:clave@ep-algo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Opcionales:
# CARPETA_RESPALDOS=/home/tu-usuario/Respaldos/GestionDeVacaciones
# RESPALDOS_A_CONSERVAR=30
